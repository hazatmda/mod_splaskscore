<?xml version='1.0' encoding='utf-8'?>
<extension type="module" client="administrator" method="upgrade">
    <name>mod_splaskscore</name>
    <author>Muhammad Azizan Hazim</author>
    <version>1.9.6</version>
    <description>Modul papan pemuka operasi SPLaSK dengan sistem analitik premium bersatu versi 1.9.6</description>
    <scriptfile>script.php</scriptfile>
    <files>
        <filename module="mod_splaskscore">mod_splaskscore.php</filename>
        <filename>helper.php</filename>
        <filename>script.php</filename>
        <folder>tmpl</folder>
        <folder>sql</folder>
        <folder>packages</folder>
    </files>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <media folder="media" destination="mod_splaskscore">
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset name="about" label="About">

<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="administrator" method="upgrade">
    <name>mod_splaskscore</name>
    <author>Muhammad Azizan Hazim</author>
    <version>1.1.8</version>
    <description>Module to display SPLaSK Score in Joomla Admin Dashboard (Logik and label gred versi 1.1.8)</description>
    <files>
        <filename module="mod_splaskscore">mod_splaskscore.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="splask_token"
                    type="text"
                    label="SPLaSK Token"
                    description="Masukkan token SPLaSK anda untuk paparan markah."
                    required="true"
                />
                <field
                    name="design_preset"
                    type="list"
                    label="Design Preset"
                    description="Pilih reka bentuk paparan markah SPLaSK."
                    default="modern_circle"
                >
                    <option value="modern_circle">Modern Circle</option>
                </field>
            </fieldset>
        </fields>
    </config>
    <creationDate>2025-07-22</creationDate>
    <packagename>mod_splaskscore</packagename>
    <license>GNU General Public License v3.0</license>
    <updateservers>
        <server type="extension" priority="1" name="mod_splaskscore">
            https://raw.githubusercontent.com/hazatmda/mod_splaskscore/main/updates.xml
        </server>
    </updateservers>
</extension>

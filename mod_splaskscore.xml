ps://github.com/hazatmda/mod_splaskscore&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;github.com/hazatmda/mod_splaskscore&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;col-12 col-md-6&quot;&gt;&lt;div class=&quot;border rounded-3 p-3 h-100 bg-black bg-opacity-25&quot;&gt;&lt;div class=&quot;small text-light-emphasis mb-1&quot;&gt;Issue Tracker&lt;/div&gt;&lt;a class=&quot;fw-semibold link-light text-decoration-none&quot; href=&quot;https://github.com/hazatmda/mod_splaskscore/issues&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;GitHub Issues&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;col-12 col-md-6&quot;&gt;&lt;div class=&quot;border rounded-3 p-3 h-100 bg-black bg-opacity-25&quot;&gt;&lt;div class=&quot;small text-light-emphasis mb-1&quot;&gt;Analytics Scope&lt;/div&gt;&lt;div class=&quot;fw-semibold text-light&quot;&gt;Stable UUID per module, adopted automatically&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;col-12 col-md-6&quot;&gt;&lt;div class=&quot;border rounded-3 p-3 h-100 bg-black bg-opacity-25&quot;&gt;&lt;div class=&quot;small text-light-emphasis mb-1&quot;&gt;Daily Snapshot Guard&lt;/div&gt;&lt;div class=&quot;fw-semibold text-light&quot;&gt;One record per day, enforced by a unique key&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;col-12 col-md-4&quot;&gt;&lt;div class=&quot;border rounded-3 p-3 h-100 bg-black bg-opacity-25&quot;&gt;&lt;div class=&quot;small text-light-emphasis mb-1&quot;&gt;Version&lt;/div&gt;&lt;div class=&quot;fw-semibold text-light&quot;&gt;versi 1.9.6&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;col-12 col-md-4&quot;&gt;&lt;div class=&quot;border rounded-3 p-3 h-100 bg-black bg-opacity-25&quot;&gt;&lt;div class=&quot;small text-light-emphasis mb-1&quot;&gt;Joomla Compatibility&lt;/div&gt;&lt;div class=&quot;fw-semibold text-light&quot;&gt;Joomla 5.x&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;col-12 col-md-4&quot;&gt;&lt;div class=&quot;border rounded-3 p-3 h-100 bg-black bg-opacity-25&quot;&gt;&lt;div class=&quot;small text-light-emphasis mb-1&quot;&gt;PHP Compatibility&lt;/div&gt;&lt;div class=&quot;fw-semibold text-light&quot;&gt;PHP 8.1+&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" />
            </fieldset>
        </fields>
    </config>

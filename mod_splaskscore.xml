<?xml version='1.0' encoding='utf-8'?>
<extension type="module" client="administrator" method="upgrade">
    <name>mod_splaskscore</name>
    <author>Muhammad Azizan Hazim</author>
    <version>1.6.6</version>
    <description>Modul papan pemuka operasi SPLaSK dengan sistem analitik premium bersatu versi 1.6.6</description>
    <scriptfile>script.php</scriptfile>
    <files>
        <filename module="mod_splaskscore">mod_splaskscore.php</filename>
        <filename>helper.php</filename>
        <filename>script.php</filename>
        <filename>access.xml</filename>
        <folder>tmpl</folder>
        <folder>sql</folder>
        <folder>packages</folder>
    </files>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <media folder="media" destination="mod_splaskscore">
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="splask_token" type="text" label="SPLaSK Token" description="Masukkan token SPLaSK anda untuk paparan markah." required="true" />
                <field name="appearance_mode" type="list" label="Mod Paparan" description="Pilih mod paparan: cerah, gelap, atau automatik mengikut tema pentadbir/peranti." default="light">
                    <option value="light">Cerah</option>
                    <option value="dark">Gelap</option>
                    <option value="auto">Automatik</option>
                </field>
                <field name="analytics_scheduler_note" type="note" label="Nota Operasi Automasi" description="Kutipan analitik automatik bergantung pada Joomla Scheduled Tasks yang aktif dalam persekitaran hosting. Masa kutipan harian terurus menggunakan zon masa Joomla, dan runner cron/Scheduled Tasks hosting mesti menjalankan Joomla Scheduled Tasks untuk menjamin kutipan automatik." />
                <field name="analytics_multi_module_note" type="note" label="Nota Penjadual Berbilang Modul" description="SPLaSK Score menggunakan satu Joomla Scheduled Task yang dikongsi. Kutipan masa jalan memproses setiap modul diterbitkan yang diaktifkan, manakala pemasangan/naik taraf menyelaraskan modul diterbitkan pertama/terkini dan simpanan modul selepas itu membenarkan modul terakhir disimpan mengawal jadual dikongsi." />
                <field name="analytics_auto_enabled" type="radio" label="Aktifkan Kutipan Analitik Automatik" description="Selaraskan Joomla Scheduled Task secara automatik daripada tetapan modul ini. Runner Joomla Scheduled Tasks mesti beroperasi dalam persekitaran hosting untuk menjamin kutipan automatik." default="1" layout="joomla.form.field.radio.switcher">
                    <option value="0">JDISABLED</option>
                    <option value="1">JENABLED</option>
                </field>
                <field name="analytics_frequency" type="list" label="Kekerapan Kutipan" description="Kekerapan tugas penjadual terurus mengutip analitik apabila Joomla Scheduled Tasks sedang berjalan." default="daily">
                    <option value="daily">Harian</option>
                    <option value="hourly">Setiap Jam</option>
                </field>
                <field name="analytics_collection_time" type="time" label="Masa Kutipan" description="Masa kutipan harian mengikut zon masa Joomla yang digunakan oleh tugas penjadual terurus apabila Joomla Scheduled Tasks sedang berjalan." default="06:00" showon="analytics_frequency:daily" />
                <field name="analytics_duplicate_cooldown" type="number" label="Tempoh Bertenang Pendua (minit)" description="Sela minimum sebelum snapshot analitik yang sama boleh disimpan semula." default="10" min="1" max="1440" />
                <field name="analytics_retention_enabled" type="radio" label="Aktifkan Pengekalan Analitik" description="Dimatikan secara lalai supaya sejarah analitik enterprise kekal berterusan. Aktifkan hanya jika organisasi mahu pangkasan automatik." default="0" layout="joomla.form.field.radio.switcher">
                    <option value="0">JDISABLED</option>
                    <option value="1">JENABLED</option>
                </field>
                <field name="analytics_retention_days" type="number" label="Pengekalan Analitik (hari)" description="Digunakan hanya apabila pengekalan analitik diaktifkan secara manual; rekod lebih lama daripada nilai ini akan dipangkas." default="365" min="1" showon="analytics_retention_enabled:1" />
                <field name="analytics_max_rows" type="number" label="Maksimum Baris Sejarah" description="Digunakan hanya apabila pengekalan analitik diaktifkan secara manual; had rekod bagi setiap pasangan modul/token selepas pangkasan." default="500" min="1" showon="analytics_retention_enabled:1" />
                <field name="analytics_rows_per_page" type="number" label="Baris Setiap Halaman" description="Bilangan rekod sejarah analitik yang dipaparkan pada setiap halaman jadual klien." default="7" min="1" max="50" />
                <field name="analytics_scheduler_status" type="text" label="Status Penjadual" description="Status baca sahaja untuk Joomla Scheduled Task terurus SPLaSK selepas simpanan modul terakhir. Ini tidak menggantikan keperluan hosting untuk runner Joomla Scheduled Tasks yang aktif." readonly="true" default="Menunggu simpanan" />
                <field name="analytics_last_successful_collection" type="text" label="Kutipan Berjaya Terakhir" description="Cap masa baca sahaja daripada rekod kesihatan analitik terkini yang diketahui oleh modul ini." readonly="true" default="" />
            </fieldset>
            <fieldset name="configuration" label="Configuration">
                <field name="configuration_note" type="note" label="Dashboard Branding" description="Configure dashboard, analytics, button, KPI, and graph labels without changing the dashboard architecture or analytics behavior." />
                <field name="dashboard_title" type="text" label="Dashboard Title" default="Markah Penilaian SPLaSK" />
                <field name="dashboard_subtitle" type="text" label="Dashboard Subtitle" default="Papan pemuka pemantauan operasi" />
                <field name="analytics_title" type="text" label="Analytics Modal Title" default="Sejarah &amp; Analitik SPLaSK" />
                <field name="analytics_subtitle" type="text" label="Analytics Subtitle" default="Rekod markah terkini dan trend prestasi." />
                <field name="button_verification_label" type="text" label="Verification Button Label" default="Lihat Pengesahan Penuh" />
                <field name="button_history_label" type="text" label="Analytics Button Label" default="Sejarah &amp; Analitik" />
                <field name="button_refresh_label" type="text" label="Refresh Button Label" default="Segar Semula Analitik" />
                <field name="button_refresh_loading_label" type="text" label="Refresh Loading Label" default="Menyegar semula..." />
                <field name="button_refresh_current_label" type="text" label="Refresh Current Label" default="Sudah Terkini" />
                <field name="button_refresh_failed_label" type="text" label="Refresh Failed Label" default="Segar Semula Gagal" />
                <field name="button_close_label" type="text" label="Close Button Label" default="Tutup" />
                <field name="kpi_mini_trend_label" type="text" label="Mini Trend KPI Label" default="Trend 7 Hari" />
                <field name="kpi_check_date_label" type="text" label="Check Date KPI Label" default="Tarikh Semakan" />
                <field name="kpi_next_check_label" type="text" label="Next Check KPI Label" default="Semakan Seterusnya" />
                <field name="kpi_score_today_label" type="text" label="Score Today KPI Label" default="Skor Hari Ini" />
                <field name="kpi_lowest_score_label" type="text" label="Lowest Score KPI Label" default="Skor Terendah" />
                <field name="kpi_total_records_label" type="text" label="Total Records KPI Label" default="Jumlah Rekod" />
                <field name="kpi_total_records_caption" type="text" label="Total Records Caption" default="Semua rekod DB" />
                <field name="kpi_rows_per_page_label" type="text" label="Rows Per Page Label" default="Baris Setiap Halaman" />
                <field name="graph_mini_trend_aria_label" type="text" label="Mini Trend Graph Label" default="Graf garis trend operasi tujuh hari" />
                <field name="graph_history_chart_aria_label" type="text" label="Analytics Graph Label" default="Carta trend peratus SPLaSK" />
                <field name="history_table_aria_label" type="text" label="History Table Label" default="Senarai sejarah SPLaSK boleh ditatal" />
                <field name="history_table_date_label" type="text" label="History Date Column Label" default="Tarikh" />
                <field name="history_table_time_label" type="text" label="History Time Column Label" default="Masa Semakan" />
                <field name="history_table_score_label" type="text" label="History Score Column Label" default="Markah" />
                <field name="history_table_grade_label" type="text" label="History Grade Column Label" default="Gred" />
                <field name="history_table_status_label" type="text" label="History Status Column Label" default="Status" />
                <field name="score_loading_label" type="text" label="Dashboard Loading Label" default="Memuatkan..." />
                <field name="status_waiting_label" type="text" label="Dashboard Waiting Status Label" default="Menunggu semakan" />
                <field name="history_pagination_aria_label" type="text" label="History Pagination Label" default="Navigasi halaman sejarah" />
                <field name="history_previous_label" type="text" label="Previous Page Label" default="Sebelumnya" />
                <field name="history_next_label" type="text" label="Next Page Label" default="Seterusnya" />
                <field name="history_page_status_template" type="text" label="Page Status Template" description="Use {start}, {end}, and {total} placeholders." default="Memaparkan {start}–{end} daripada {total}" />
                <field name="history_page_number_aria_template" type="text" label="Page Number Accessibility Template" description="Use {page} placeholder." default="Pergi ke halaman sejarah {page}" />
                <field name="history_empty_label" type="text" label="Empty History Label" default="Belum ada rekod sejarah. Rekod akan disimpan selepas markah berjaya dimuatkan." />
                <field name="history_loading_label" type="text" label="History Loading Label" default="Memuatkan sejarah..." />
                <field name="history_load_failed_label" type="text" label="History Load Failed Label" default="Sejarah tidak dapat dimuatkan." />
                <field name="history_connection_error_label" type="text" label="History Connection Error Label" default="Ralat sambungan semasa memuatkan sejarah." />
            </fieldset>
            <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
                <field name="rules" type="rules" label="JFIELD_RULES_LABEL" filter="rules" validate="rules" component="com_modules" section="module" />
            </fieldset>
            <fieldset name="about" label="About">
                <field name="about_metadata_panel" type="note" label="SPLaSK Score Metadata" class="p-0 border-0 bg-transparent shadow-none" description="                         &lt;div class=&quot;card border shadow-sm bg-body text-body&quot;&gt;                             &lt;div class=&quot;card-body p-4&quot;&gt;                                 &lt;div class=&quot;d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4&quot;&gt;                                     &lt;div&gt;                                         &lt;p class=&quot;text-uppercase text-body-secondary fw-semibold small mb-1&quot;&gt;Product Information&lt;/p&gt;                                         &lt;h3 class=&quot;h5 mb-1&quot;&gt;SPLaSK Score&lt;/h3&gt;                                         &lt;p class=&quot;mb-0 text-body-secondary&quot;&gt;Administrator dashboard module with managed Joomla Scheduled Task analytics.&lt;/p&gt;                                     &lt;/div&gt;                                     &lt;span class=&quot;badge rounded-pill text-bg-success align-self-lg-start&quot;&gt;Stable&lt;/span&gt;                                 &lt;/div&gt;                                 &lt;div class=&quot;row g-3&quot;&gt;                                     &lt;div class=&quot;col-12 col-md-6&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;Owner&lt;/div&gt;                                             &lt;div class=&quot;fw-semibold&quot;&gt;Muhammad Azizan Hazim&lt;/div&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                     &lt;div class=&quot;col-12 col-md-6&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;Organization&lt;/div&gt;                                             &lt;div class=&quot;fw-semibold&quot;&gt;Unit Infrastruktur dan Keselamatan Digital, Bahagian Digital dan Teknologi Maklumat (BDTM)&lt;/div&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                     &lt;div class=&quot;col-12 col-md-6&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;Repository&lt;/div&gt;                                             &lt;a class=&quot;fw-semibold text-decoration-none&quot; href=&quot;https://github.com/hazatmda/mod_splaskscore&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;github.com/hazatmda/mod_splaskscore&lt;/a&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                     &lt;div class=&quot;col-12 col-md-6&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;Issue Tracker&lt;/div&gt;                                             &lt;a class=&quot;fw-semibold text-decoration-none&quot; href=&quot;https://github.com/hazatmda/mod_splaskscore/issues&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;GitHub Issues&lt;/a&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                     &lt;div class=&quot;col-12 col-md-4&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;Version&lt;/div&gt;                                             &lt;div class=&quot;fw-semibold&quot;&gt;1.6.6&lt;/div&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                     &lt;div class=&quot;col-12 col-md-4&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;Joomla Compatibility&lt;/div&gt;                                             &lt;div class=&quot;fw-semibold&quot;&gt;Joomla 5.x&lt;/div&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                     &lt;div class=&quot;col-12 col-md-4&quot;&gt;                                         &lt;div class=&quot;border rounded-3 p-3 h-100 bg-body-tertiary&quot;&gt;                                             &lt;div class=&quot;small text-body-secondary mb-1&quot;&gt;PHP Compatibility&lt;/div&gt;                                             &lt;div class=&quot;fw-semibold&quot;&gt;PHP 8.1+&lt;/div&gt;                                         &lt;/div&gt;                                     &lt;/div&gt;                                 &lt;/div&gt;                             &lt;/div&gt;                         &lt;/div&gt;                     " />
            </fieldset>
        </fields>
    </config>

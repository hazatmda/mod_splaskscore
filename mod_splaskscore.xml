<?xml version='1.0' encoding='utf-8'?>
<extension type="module" client="administrator" method="upgrade">
    <name>mod_splaskscore</name>
    <author>Muhammad Azizan Hazim</author>
    <version>1.2.5</version>
    <description>Module to display SPLaSK Score in Joomla Admin Dashboard (Logik, label gred, and adaptive presets versi 1.2.5)</description>
    <scriptfile>script.php</scriptfile>
    <files>
        <filename module="mod_splaskscore">mod_splaskscore.php</filename>
        <filename>helper.php</filename>
        <filename>script.php</filename>
        <folder>tmpl</folder>
        <folder>sql</folder>
        <folder>packages</folder>
    </files>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <media folder="media" destination="mod_splaskscore">
        <folder>css</folder>
        <folder>js</folder>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="splask_token" type="text" label="SPLaSK Token" description="Masukkan token SPLaSK anda untuk paparan markah." required="true" />
                <field name="design_preset" type="list" label="Design Preset" description="Pilih reka bentuk paparan markah SPLaSK." default="modern_circle">
                    <option value="default">Default Card</option>
                    <option value="modern_circle">Modern Circle</option>
                    <option value="glass_card">Glass Card</option>
                    <option value="minimal_clean">Minimal Clean</option>
                    <option value="gradient_ring">Gradient Ring</option>
                    <option value="compact_badge">Compact Badge</option>
                    <option value="dashboard_tile">Dashboard Tile</option>
                    <option value="neon_glass">Neon Glass</option>
                    <option value="minimal_oled">Minimal OLED</option>
                    <option value="enterprise_kpi">Enterprise KPI</option>
                    <option value="arc_reactor">Arc Reactor</option>
                </field>
                <field name="appearance_mode" type="list" label="Appearance Mode" description="Pilih mod paparan: cerah, gelap, atau automatik mengikut tema pentadbir/peranti." default="light">
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="auto">Auto</option>
                </field>
                <field name="analytics_duplicate_cooldown" type="number" label="Duplicate Cooldown (minutes)" description="Minimum interval before identical analytics snapshots can be stored again." default="10" min="1" max="1440" />
                <field name="analytics_retention_days" type="number" label="Analytics Retention (days)" description="Automatically prune analytics records older than this number of days." default="365" min="1" />
                <field name="analytics_max_rows" type="number" label="Maximum History Rows" description="Maximum analytics records retained per module/token pair after pruning." default="500" min="1" />
            </fieldset>
        </fields>
    </config>
    <creationDate>2025-07-22</creationDate>
    <packagename>mod_splaskscore</packagename>
    <license>GNU General Public License v3.0</license>
    <updateservers>
        <server type="extension" priority="1" name="mod_splaskscore">
            https://raw.githubusercontent.com/hazatmda/mod_splaskscore/main/updates.xml
        </server>
    </updateservers>
</extension>